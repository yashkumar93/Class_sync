# .env — copy this to .env and fill in values (never commit .env to git)
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost,10.0.2.2

# PostgreSQL (Supabase) — leave blank to fall back to local SQLite
DATABASE_URL=

# Supabase Auth
SUPABASE_URL=https://<project-id>.supabase.co
SUPABASE_KEY=<anon-public-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Supabase Storage bucket for media uploads (production only)
SUPABASE_BUCKET_NAME=classsync-media

# CORS — space-separated list of allowed origins (production)
CORS_ALLOWED_ORIGINS=

# Media / Static (local dev only — production uses Supabase Storage)
MEDIA_ROOT=media/

# Firebase Admin SDK — optional, push notifications degrade gracefully if unset
FIREBASE_CREDENTIALS=
